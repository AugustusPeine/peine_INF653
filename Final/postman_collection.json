            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Admin User\", \"email\": \"admin@example.com\", \"password\": \"admin123\", \"role\": \"admin\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
